# Names only. Values live in the cloud session env config and in `wrangler secret put`.
# Required
# Token from My Profile -> API Tokens -> "Edit Cloudflare Workers" template (NOT an R2 token; those cannot deploy Workers)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=f23a90e15150a8af524f01d3bce393ab
# R2 S3-compatible credentials (optional; Supabase Storage is the default file store). Endpoint is public, keys are secrets.
R2_S3_ENDPOINT=https://f23a90e15150a8af524f01d3bce393ab.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GH_TOKEN=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
PREFLIGHT_TEST_EMAIL=
# Status channel: HEARTBEAT_EMAIL gets the 5-hourly heartbeat via Resend (your Resend sign-up address until a domain is verified). ANTHROPIC_API_KEY is optional: the product LLM is Workers AI through the Worker's AI binding (no key)
ANTHROPIC_API_KEY=
HEARTBEAT_EMAIL=
# Supabase
SUPABASE_PROJECT_REF=dhjumvswohajnusdifim
SUPABASE_URL=https://dhjumvswohajnusdifim.supabase.co
# Project Settings -> API Keys. New projects show sb_publishable_ (paste as ANON) and sb_secret_ (paste as SERVICE_ROLE); legacy JWTs work too.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Account -> Access Tokens (sbp_...), lets the CLI link and push migrations
SUPABASE_ACCESS_TOKEN=
# Direct connection (migrations/CLI only; IPv6 on free tier): postgresql://postgres:<PASSWORD>@db.dhjumvswohajnusdifim.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Pooler, transaction mode (what the Worker uses; IPv4): postgresql://postgres.dhjumvswohajnusdifim:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_POOLER_URL=
# Project
PROJECT_SLUG=30x-hackathon
# AWS (Agent Toolkit, new AWS experience; credentials via `aws login`, no keys). Not needed during the run.
AWS_PROFILE_NAME=
AWS_REGION=us-east-2
# SES (product email: OTP via Supabase SMTP, escalations from the Worker). IAM user thesaurus-ses, ses:SendEmail only.
# Live in Worker secrets and Supabase auth config; optional in the session env (local QA logs instead of sending).
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
S3_BUCKET=
SES_FROM=
# TypeSafe (optional reserve, see docs/RESOURCES.md): Jev / System One typed decisions
TYPESAFE_API_KEY=
